{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"tests",
		"src/types/*"
	],
	"plugins": ["typescript", "vitest"],
	"options": {
		"typeAware": true
	},
	"rules": {
		"typescript/unbound-method": "off"
	},
	"overrides": [
		{
			"files": ["src/internal/errorMessages.ts"],
			"rules": {
				"typescript/restrict-template-expressions": "off"
			}
		}
	]
}
